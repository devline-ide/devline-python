{
  "schemaVersion": 1,
  "apiVersion": 6,
  "compatibility": {"minIdeVersion": "0.1.0", "capabilities": ["ui.webviews", "ui.settings", "editor.file-commands", "terminal.programs"]},
  "entryPoint": "devline.python.PythonExtension",
  "libraries": ["lib/devline-python-0.1.0.jar"],
  "extension": {
    "schemaVersion": 1,
    "id": "devline.python",
    "version": "0.1.2",
    "name": {"en": "Python Runner", "ru": "Запуск Python"},
    "description": {"en": "Run project Python scripts in the integrated terminal.", "ru": "Запуск Python-скриптов проекта во встроенном терминале."},
    "publisher": "DevLine",
    "icon": "data:image/png;base64,",
    "rpcNamespace": "pythonRunner",
    "enabledByDefault": true,
    "commands": [{"id": "run", "title": {"en": "Run Python file", "ru": "Запустить Python-файл"}, "fileExtensions": ["py"]}],
    "tools": []
  },
  "webviews": [{"id": "settings", "title": {"en": "Python", "ru": "Python"}, "html": "web/python.html", "location": "settings", "icon": "terminal", "methods": ["settings", "configure", "reset"]}]
}
